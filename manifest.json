{
  "schemaVersion": 1,
  "id": "org.yard.console",
  "name": "YARD Control Plane",
  "version": "0.2.0",
  "author": "YARD Team",
  "description": "Control plane and HUD for Beads task pipelines, GitHub activity, agent status, and OpenSpec contracts.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "YARD & Beads Control Plane",
    "description": "At-a-glance Beads adoption, current active in-work bead, GitHub PRs, agent status, and OpenSpec definitions.",
    "category": "AI",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 15,
      "webConsoleUrl": "http://localhost:8000"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "webConsoleUrl",
        "type": "string",
        "label": "Web Console URL",
        "defaultValue": "http://localhost:8000"
      }
    ]
  }
}
