#!/usr/bin/env bash
# YARD status provider CLI for Omarchy Quickshell plugin

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

STATUS_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/yard/status.json"

# If status file doesn't exist or is stale (>60s), attempt a quick sync pass
if [[ ! -f "$STATUS_FILE" && -f "$REPO_DIR/scripts/yard-sync.py" ]]; then
  python3 "$REPO_DIR/scripts/yard-sync.py" >/dev/null 2>&1 || true
fi

if [[ -f "$STATUS_FILE" ]]; then
  cat "$STATUS_FILE"
else
  # Emit sensible fallback fixture if state file not yet initialized
  cat <<'EOF'
{
  "version": 1,
  "updatedAt": "2026-09-20T21:00:00Z",
  "fleet": {
    "activeCrews": 4,
    "maxCrews": 8,
    "alarming": true,
    "alarmCount": 1
  },
  "cursor": {
    "storiesCount": 3,
    "tokenBurn": 124000,
    "activePr": "#42 Tokyo Night sync",
    "status": "nominal"
  },
  "grok": {
    "canaryTag": "v1.4.2-rc1",
    "canaryPercent": 10,
    "healthScore": 99.8,
    "status": "staging"
  },
  "localWatch": {
    "zeroEgress": true,
    "alerts": [
      {
        "id": "SIG-901",
        "storyId": "CORE-104",
        "type": "RepeatedSignature",
        "severity": "urgent",
        "message": "pytest repeated 3 consecutive times without code edits"
      }
    ]
  },
  "beads": {
    "activeProject": "mowgli42/schwerpunkt",
    "completed": {
      "id": "schwerpunkt-i0i.2.5",
      "title": "Operator REST API (manual demo, no AI)",
      "status": "closed"
    },
    "inWork": {
      "id": "schwerpunkt-i0i.3.1",
      "title": "Observation impact hints + orient plan-impact",
      "status": "in_progress",
      "agent": "Cursor Cloud Agent (bc-709a)",
      "model": "gemini-3.8-flash",
      "specPath": "openspec/specs/orientation-layer/spec.md",
      "specId": "openspec/specs/orientation-layer/spec.md"
    },
    "next": {
      "id": "schwerpunkt-i0i.3.2",
      "title": "MTO decision tree + Observe-Orient integration",
      "status": "open"
    }
  },
  "beadsSystem": {
    "installed": true,
    "binaryPath": "/home/tprettol/.local/bin/bd",
    "version": "bd (beads) 0.9.2-dolt",
    "doltInstalled": true,
    "adoptedRepos": 7,
    "totalRepos": 7,
    "adoptionPercent": 100,
